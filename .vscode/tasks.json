{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend (Vite)",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Backend (Flask)",
            "type": "shell",
            "command": "${workspaceFolder}/venv/Scripts/python backend/app.py",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Full App",
            "dependsOn": [
                "Start Frontend (Vite)",
                "Start Backend (Flask)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
